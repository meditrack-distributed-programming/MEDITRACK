# Normalize line endings: text files use LF
* text=auto eol=lf

*.sh text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf

# The Gradle wrapper script runs on Linux and must keep LF
gradlew text eol=lf

# Windows batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Java archives are binary
*.jar binary

# Images are binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.webp binary
*.ico binary
