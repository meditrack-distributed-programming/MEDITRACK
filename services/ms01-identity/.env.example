# Copy to .env and adjust. Never commit the .env file.
SERVER_PORT=8081

# Active Directory over LDAPS. The defaults match the local Samba controller.
LDAP_URL=ldaps://localhost:636
LDAP_DOMAIN=meditrack.local
LDAP_BASE_DN=OU=MediTrack,DC=meditrack,DC=local
# PEM file of the certificate authority of the directory (absolute path)
LDAP_CA_CERTIFICATE=
